@{
    ViewData["Title"] = "About";
}
<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/about.css" />

@section Scripts {
    <script src="~/js/home.js"></script>
}

<div class="raceday-home">

    <!-- ABOUT HERO -->
    <section class="about-page-hero">
        <div class="hero-overlay">
            <div class="hero-content">
                <p class="hero-eyebrow reveal">ABOUT RACEDAY</p>
                <h1 class="reveal">
                    Built for Athletes.<br />
                    <span>Driven by Community.</span>
                </h1>
                <p class="hero-text reveal">
                    We bring event information, race routes, and results together
                    so you can focus on what matters most: crossing the finish line.
                </p>
            </div>
        </div>
    </section>

    <!-- OUR STORY -->
    <section class="intro-section">
        <div class="intro-content">
            <p class="section-label reveal">OUR STORY IS</p>
            <h2 class="reveal">More than just a race tracker.</h2>
            <p class="reveal">
                RaceDay was founded with a simple goal: to make race day seamless for everyone.
                Whether you are an organiser managing hundreds of participants, or a runner
                chasing a personal best, we provide the tools you need to succeed.
            </p>
            <p class="reveal" style="margin-top: 1rem;">
                From live weather updates and detailed elevation maps to instant result publishing,
                RaceDay is designed to handle the logistics so you can handle the race.
            </p>
        </div>
    </section>

    <!-- MISSION & VISION -->
    <section class="mission-section">
        <div class="section-heading reveal">
            <p class="section-label">OUR PURPOSE</p>
            <h2>Mission & Vision</h2>
        </div>

        <div class="mission-grid">
            <div class="mission-card reveal">
                <h3>Our Mission</h3>
                <p>
                    To empower athletes and organisers with a reliable, intuitive platform
                    that simplifies event management, enhances race day experiences, and
                    celebrates every achievement, from the first step to the final sprint.
                </p>
            </div>

            <div class="mission-card reveal">
                <h3>Our Vision</h3>
                <p>
                    To be the leading digital companion for the running, cycling, and walking
                    community, fostering a connected ecosystem where every race is accessible,
                    well-organised, and deeply rewarding.
                </p>
            </div>
        </div>
    </section>

    <!-- OUR VALUES -->
    <section class="values-section">
        <div class="section-heading reveal">
            <p class="section-label">WHAT WE STAND FOR</p>
            <h2>Our Core Values</h2>
        </div>

        <div class="values-grid">
            <div class="value-card reveal">
                <h3>Community</h3>
                <p>We believe in the power of people coming together to push limits and support one another.</p>
            </div>
            <div class="value-card reveal">
                <h3>Performance</h3>
                <p>We build fast, reliable tools because on race day, every second and every detail counts.</p>
            </div>
            <div class="value-card reveal">
                <h3>Integrity</h3>
                <p>We deliver accurate results, transparent data, and a fair platform for every participant.</p>
            </div>
        </div>
    </section>

    <!-- SPONSORS -->
    <section class="sponsors-section">
        <div class="section-heading reveal">
            <p class="section-label">OUR PARTNERS</p>
            <h2>Trusted By The Best</h2>
            <p>We are proud to partner with leading brands that support the athletic community.</p>
        </div>

        <div class="sponsor-grid">
            <div class="sponsor-logo reveal">
                <img src="~/images/hollard_sponsor.jpg" alt="Hollard Logo" />
            </div>
            <div class="sponsor-logo reveal">
                <img src="~/images/Discovery-sponsor.png" alt="Discovery Logo" />
            </div>
            <div class="sponsor-logo reveal">
                <img src="~/images/OldMutual_sponsor.png" alt="Old Mutual Logo" />
            </div>
            <div class="sponsor-logo reveal">
                <img src="~/images/totalsports-sponsor.png" alt="Total Sports Logo" />
            </div>
            <div class="sponsor-logo reveal">
                <img src="~/images/Redbull-sponsor.png" alt="Redbull Logo" />
            </div>
            <div class="sponsor-logo reveal">
                <img src="~/images/Capeunionmart-sponsor.jpg" alt="Cape Union Mart Logo" />
            </div>
        </div>
    </section>

    <!-- FINAL CTA -->
    <section class="join-section">
        <div class="join-content reveal">
            <p class="section-label">JOIN THE COMMUNITY</p>
            <h2>Ready to experience RaceDay?</h2>
            <p>Find an event near you and start your journey today.</p>
            <a href="/Home/Index" class="home-button home-button-primary">Back to Home</a>
        </div>
    </section>

</div>
