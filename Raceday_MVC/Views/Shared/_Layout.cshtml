<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Raceday_MVC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Raceday_MVC.styles.css" asp-append-version="true" />

    <style>
        .raceday-nav {
            background: #0b0b0f !important;
            border-bottom: 2px solid #e10600;
            padding: .6rem 1rem;
        }

        .raceday-brand {
            font-weight: 800;
            font-size: 1.5rem;
            color: #fff !important;
        }

            .raceday-brand span {
                color: #ff4a1c;
            }

        .raceday-nav .nav-link {
            color: #fff;
            font-weight: 600;
        }

            .raceday-nav .nav-link:hover {
                color: #ff4a1c;
            }

        #nav-auth a, #nav-auth span {
            color: #fff;
        }

        #nav-auth .raceday-hi {
            color: #c9ccd6 !important;
        }

        .auth-forgot {
            display: block;
            text-align: center;
            margin-top: .75rem;
            color: #a0a5b5;
            font-size: .9rem;
            text-decoration: none;
        }

            .auth-forgot:hover {
                color: #ff4a1c;
            }

        .demo-sms {
            position: fixed;
            top: 1rem;
            right: 1rem;
            z-index: 100000;
            max-width: 320px;
            background: #1a1a1a;
            color: #fff;
            border-left: 4px solid #ff3d00;
            border-radius: 12px;
            padding: .9rem 1.1rem;
            box-shadow: 0 12px 40px rgba(0,0,0,.5);
        }

            .demo-sms small {
                display: block;
                color: #a0a5b5;
                font-size: .75rem;
                margin: .15rem 0;
            }

            .demo-sms strong {
                font-size: 1.4rem;
                letter-spacing: 4px;
                color: #ff4a1c;
            }

            .demo-sms button {
                margin-top: .5rem;
                background: transparent;
                border: 1px solid #555;
                color: #fff;
                border-radius: 8px;
                padding: .25rem .75rem;
                cursor: pointer;
            }

        .auth-modal a.auth-forgot {
            display: block;
            text-align: center;
            margin-top: .75rem;
            color: #a0a5b5;
            font-size: .9rem;
            text-decoration: none;
        }

            .auth-modal a.auth-forgot:hover {
                color: #ff4a1c;
            }
    </style>

</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark raceday-nav">
        <div class="container-fluid">
            <a class="navbar-brand raceday-brand" asp-area="" asp-controller="Home" asp-action="Index">Race<span>Day</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Events" asp-action="Index">Events</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="About">About Us</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav" id="nav-auth"></ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Raceday_MVC - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    <div id="auth-overlay" class="auth-overlay" hidden>
        <div class="auth-modal" role="dialog" aria-modal="true" aria-labelledby="auth-title">
            <button type="button" id="auth-close" class="auth-close" aria-label="Close">&times;</button>
            <h2 id="auth-title">Log in</h2>
            <p id="auth-message" class="auth-message"></p>

            <div class="auth-tabs">
                <button type="button" class="auth-tab active" data-mode="login">Log in</button>
                <button type="button" class="auth-tab" data-mode="signup">Sign up</button>
            </div>

            <form id="login-form" class="auth-form">
                <input type="email" id="login-email" placeholder="Email" required />
                <input type="password" id="login-password" placeholder="Password" required />
                <button type="submit" class="auth-submit">Log in</button>
                <a href="#" id="forgot-link" class="auth-forgot">Forgot password?</a>
            </form>

            <form id="signup-form" class="auth-form" hidden>
                <input type="text" id="signup-name" placeholder="Full name" required />
                <input type="email" id="signup-email" placeholder="Email (@@participant or @@organiser)" required />
                <input type="password" id="signup-password" placeholder="Password" required />
                <label for="signup-dob" class="auth-label">Date of birth (required for participants)</label>
                <input type="date" id="signup-dob" />
                <input type="tel" id="signup-phone" placeholder="Phone number" />
                <button type="submit" class="auth-submit">Create account</button>
            </form>

            <form id="forgot-form" class="auth-form" hidden>
                <p class="auth-message">Enter the phone number you signed up with and we'll send you a 6-digit code.</p>
                <input type="tel" id="forgot-phone" placeholder="Phone number" required />
                <button type="submit" class="auth-submit">Send code</button>
                <a href="#" class="auth-forgot" data-back-login>Back to log in</a>
            </form>

            <form id="reset-form" class="auth-form" hidden>
                <input type="text" id="reset-code" placeholder="6-digit code" inputmode="numeric" maxlength="6" required />
                <input type="password" id="reset-password" placeholder="New password" required />
                <button type="submit" class="auth-submit">Reset password</button>
                <a href="#" class="auth-forgot" data-back-login>Back to log in</a>
            </form>

            <p id="auth-error" class="auth-error"></p>
        </div>
    </div>
    <div id="auth-toast" class="auth-toast" hidden></div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
