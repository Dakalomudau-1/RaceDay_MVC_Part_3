@{
    ViewData["Title"] = "Edit Event";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="~/css/home.css" />
<link rel="stylesheet" href="~/css/account.css" />

<div class="raceday-home">
    <section class="account-hero">
        <p class="account-eyebrow">ORGANISER</p>
        <h1>Edit Event</h1>
        <p class="account-sub">Update your event details.</p>
    </section>

    <section class="account-section">
        <div id="account-content" data-page="edit" data-event-id="@ViewBag.EventId">Loading...</div>
    </section>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="~/js/organiser.js" asp-append-version="true"></script>
}