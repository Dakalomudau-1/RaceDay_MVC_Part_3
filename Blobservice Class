using Azure.Storage.Blobs;
using Azure.Storage.Blobs.Models;

namespace RaceDay.Services
{
    public interface IBlobService
    {
        Task<string> UploadImageAsync(IFormFile file, string folder);
    }

    public class BlobService : IBlobService
    {
        private readonly IConfiguration _config;
        private static readonly string[] Allowed = { ".jpg", ".jpeg", ".png", ".webp" };

        public BlobService(IConfiguration config)
        {
            _config = config;
        }

        public async Task<string> UploadImageAsync(IFormFile file, string folder)
        {
            var ext = Path.GetExtension(file.FileName).ToLowerInvariant();
            if (!Allowed.Contains(ext))
                throw new ArgumentException("Only JPG, JPEG, PNG or WEBP images are allowed");
            if (file.Length > 5 * 1024 * 1024)
                throw new ArgumentException("Image must be 5 MB or smaller");

            var connection = _config["AzureBlobStorage:ConnectionString"];
            if (string.IsNullOrWhiteSpace(connection))
                throw new InvalidOperationException("Azure Blob Storage is not configured");

            var containerName = _config["AzureBlobStorage:ContainerName"] ?? "images";

            try
            {
                var container = new BlobContainerClient(connection, containerName);
                var blob = container.GetBlobClient($"{folder}/{Guid.NewGuid()}{ext}");

                using var stream = file.OpenReadStream();
                await blob.UploadAsync(stream, new BlobHttpHeaders { ContentType = file.ContentType });
                return blob.Uri.ToString();
            }
            catch (Exception ex)
            {
                var firstLine = (ex.Message ?? "").Split('\n')[0];
                throw new InvalidOperationException($"Azure upload failed: {ex.GetType().Name} - {firstLine}");
            }
        }
    }
}
